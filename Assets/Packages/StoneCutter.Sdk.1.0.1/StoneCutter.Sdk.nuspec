<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>StoneCutter.Sdk</id>
    <version>1.0.1</version>
    <authors>CoreLoopStudios</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/CoreLoopStudios-Org/sdk.deonphizzle.stonecutter</projectUrl>
    <description>A lightweight .NET client SDK for the StoneCutter API. Built on .NET Standard 2.1, compatible with .NET Core 3.0+, .NET 5+, Xamarin, and Unity 2021.2+.</description>
    <releaseNotes>Added new property and updated docs</releaseNotes>
    <tags>StoneCutter SDK API Client Unity</tags>
    <repository type="git" url="https://github.com/CoreLoopStudios-Org/sdk.deonphizzle.stonecutter" commit="cc1292e0fd848095999490946e7b002c535125bf" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>